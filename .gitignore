# ============================================================
# Canteen Feedback System — .gitignore
# ============================================================

# ── Python / FastAPI Backend ─────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.log
*.pot
*.pyc

# Virtual environment
venv/
env/
.venv/
ENV/

# Environment variables (contains DB credentials!)
backend/.env
.env
*.env

# ── React Native / Expo Mobile App ───────────────────────────
mobile-app/node_modules/
mobile-app/.expo/

mobile-app/ios/
mobile-app/.expo-shared/
mobile-app/dist/
mobile-app/web-build/
mobile-app/*.orig.*

# Expo EAS build cache
.easignore

# ── React Admin Dashboard ────────────────────────────────────
admin-dashboard/node_modules/
admin-dashboard/build/
admin-dashboard/.env.local
admin-dashboard/.env.development.local
admin-dashboard/.env.test.local
admin-dashboard/.env.production.local

# ── Generated APK output ─────────────────────────────────────
*.apk
*.aab
output/

# ── IDEs & Editors ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Windows ──────────────────────────────────────────────────
desktop.ini
$RECYCLE.BIN/

# ── npm / yarn ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ── Database ─────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Certificates & Keys ──────────────────────────────────────
*.pem
*.key
*.p12
*.jks
